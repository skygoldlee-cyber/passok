# .env.example — 루트 .env 스키마 정본 (시크릿 값은 절대 기재 금지)
#
# 실제 값은 루트 .env에만 둔다 (gitignore 대상). 이 파일은 "어떤 키가 유효한지"의
# 선언 목록 — check_env.js가 .env와 대조해 미선언·만료·빈 키를 탐지한다.
# 신규 시크릿 도입 시 여기에 먼저 등록할 것.
#
# 표기: 키 우측 주석에 `@required`가 있으면 .env에 값 필수 (없으면 전부 선택).

# ── AI 제작 도구 (npm run ai:* — tools/ai/llm_client.js) ────────────────
AI_PROVIDER=                # openai|anthropic|gemini (기본 openai)
AI_API_KEY=                 # 범용 오버라이드 — 비우면 공급자별 키로 폴백
AI_MODEL=                   # 모델 오버라이드(전 공급자 공통) — 비우면 공급자별 모델 env → 기본 모델
OPENAI_API_KEY=             # provider=openai일 때
ANTHROPIC_API_KEY=          # provider=anthropic일 때
GEMINI_API_KEY=             # provider=gemini일 때
OPENAI_MODEL=               # provider=openai일 때 모델 (비우면 기본)
ANTHROPIC_MODEL=            # provider=anthropic일 때 모델
GEMINI_MODEL=               # provider=gemini일 때 모델 — ai-proxy 시크릿명과 동일 규약
AI_PROXY_GOOGLE_API_KEY=    # 선택 — ai-proxy 전용 Gemini 키 (미설정 시 GEMINI_API_KEY 사용)
AI_FREE_DAILY=              # 선택 — ai-proxy Free 일일 쿼터 (미설정 시 함수 기본값 유지)

# ── 운영 CLI (report:*·admin:* — tools/lib/supabase_ops.js) ─────────────
SUPABASE_SECRET_KEY=        # Secret(구 service_role) 키 — RLS 우회, 로컬 전용
SUPABASE_URL=               # 선택 — 미설정 시 src/supabase-config.js 값 사용
SUPABASE_ACCESS_TOKEN=      # Management API PAT (schema:apply — 스키마 자동 적용용, scoped 권장: 이 프로젝트 + Database read-write)

# ── Supabase Auth 프로바이더·SMTP 자격증명 보관 (SUPABASE_DESIGN §적용 상태 — Management API PATCH·콘솔 수동 적용용) ──
SUPABASE_GOOGLE_CLIENT_ID=      # Google OAuth client_id
SUPABASE_GOOGLE_CLIENT_SECRET=  # Google OAuth client_secret
SUPABASE_KAKAO_CLIENT_ID=       # 카카오 REST API 키 (=client_id)
SUPABASE_KAKAO_CLIENT_SECRET=   # 카카오 Client Secret — 콘솔에서 재발급·폐기 가능
SUPABASE_SMTP_USER=             # 커스텀 SMTP 사용자 (매직링크 OTP — Supabase_Custom_SMTP 가이드)
SUPABASE_SMTP_PASS=             # 커스텀 SMTP 비밀번호/API키

# ── E2E 테스트 Supabase (J-102 — DSN-46 §3-1·3-2, 별도 테스트 프로젝트 전용) ──
TEST_SUPABASE_URL=          # https://<test-ref>.supabase.co — 운영 ref 지정 시 시드 중단
TEST_SUPABASE_ANON_KEY=     # 테스트 프로젝트 anon/publishable 키 (앱 오버라이드용)
TEST_SUPABASE_SERVICE_ROLE_KEY=  # 테스트 프로젝트 Secret 키 (계정 시드용 — 로컬·시크릿 전용)
TEST_E2E_PASSWORD=          # 시드 계정 공통 비밀번호 (8자 이상)

# ── 배포 가드 (tools/deploy/deploy.js — 비공개 레포 CI 상태 조회) ───────
GH_TOKEN=                   # gh 인증 대용 — GITHUB_TOKEN도 허용
GITHUB_TOKEN=

# ── 참조 파이프라인 (ref-pipeline/ — Python) ────────────────────────────
LAW_OC_KEY=                 # 법제처 Open API OC 키 (check_laws·check_mfds_notice·fetch_revision)
ELEVENLABS_API_KEY=         # 오디오북 TTS (audiobook/tts_elevenlabs.py)

# ── 공공데이터 API (tools/market·tools/import — 시장분석·시설 전화번호 보강) ──
DATA_GO_KR_SERVICE_KEY=     # data.go.kr 서비스키 (fetch_qnet_stats·enrich_facility_phones)
KOSIS_API_KEY=              # KOSIS OpenAPI 키 (fetch_qnet_stats)
HRD_OC_KEY=                 # 선택 — HRD-Net 자격통계 authKey (hrd.go.kr 별도 발급)
HRD_OC_SEQNO=               # 선택 — HRD-Net authKeySeqNo (HRD_OC_KEY와 쌍)

# ── Vercel ─────────────────────────────────────────────────────────────
VERCEL_OIDC_TOKEN=          # 단기 OIDC 토큰 — CI 수동 재현용. 수명이 짧아
                            # 만료되면 재발급(vercel CLI가 배포 시 자동 발급)

# ── Discord 운영 표면 (AD-10·AD-11 — docs/dev/runbooks/DISCORD_ADMIN.md) ─
DISCORD_WEBHOOK_URL=        # 운영 알림 채널 webhook — deploy·keepalive 알림
                            #   발신 지점이 조용히 skip되므로 미설정 허용
DISCORD_APP_ID=             # Developer Portal → Application ID (봇 명령 등록용)
DISCORD_BOT_TOKEN=          # 같은 앱의 Bot 토큰 (npm run admin:discord)
DISCORD_ANNOUNCE=           # 전체-공지 채널 webhook — 커뮤니티 공지·deploy 릴리스 노트 (AD-12)
DISCORD_ANNOUNCE_COSMETIC=  # 시험별 공지 채널 webhook — 패턴 DISCORD_ANNOUNCE_<EXAM_ID>
                            #   (exams.json id 대문자 — 신규 시험 채널 추가 시 같은 패턴으로 등록)
DISCORD_NOTIFY_MENTION=     # 푸시용 멘션 대상 — 설정 시 그 대상만 멘션 (tools/lib/discord.js)
# 참고: DISCORD_PUBLIC_KEY·ADMIN_DISCORD_ID는 .env가 아니라
#       `supabase secrets set`으로 Edge Function 측에 등록한다 (런북 §3.2)
