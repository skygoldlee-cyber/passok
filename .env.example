# .env.example — 루트 .env 스키마 정본 (시크릿 값은 절대 기재 금지)
#
# 실제 값은 루트 .env에만 둔다 (gitignore 대상). 이 파일은 "어떤 키가 유효한지"의
# 선언 목록 — check_env.js가 .env와 대조해 미선언·만료·빈 키를 탐지한다.
# 신규 시크릿 도입 시 여기에 먼저 등록할 것.
#
# 표기: 키 우측 주석에 `@required`가 있으면 .env에 값 필수 (없으면 전부 선택).

# ── AI 제작 도구 (npm run ai:* — tools/ai/llm_client.js) ────────────────
AI_PROVIDER=                # openai|anthropic|gemini (기본 openai)
AI_API_KEY=                 # 범용 오버라이드 — 비우면 공급자별 키로 폴백
AI_MODEL=                   # 모델 오버라이드 — 비우면 공급자 기본 모델
OPENAI_API_KEY=             # provider=openai일 때
ANTHROPIC_API_KEY=          # provider=anthropic일 때
GEMINI_API_KEY=             # provider=gemini일 때

# ── 운영 CLI (report:*·admin:* — tools/lib/supabase_ops.js) ─────────────
SUPABASE_SECRET_KEY=        # Secret(구 service_role) 키 — RLS 우회, 로컬 전용
SUPABASE_URL=               # 선택 — 미설정 시 src/supabase-config.js 값 사용
SUPABASE_ACCESS_TOKEN=      # Management API PAT (schema:apply — 스키마 자동 적용용, scoped 권장: 이 프로젝트 + Database read-write)

# ── 배포 가드 (tools/deploy/deploy.js — 비공개 레포 CI 상태 조회) ───────
GH_TOKEN=                   # gh 인증 대용 — GITHUB_TOKEN도 허용
GITHUB_TOKEN=

# ── 참조 파이프라인 (ref-pipeline/ — Python) ────────────────────────────
LAW_OC_KEY=                 # 법제처 Open API OC 키 (check_laws·check_mfds_notice·fetch_revision)
ELEVENLABS_API_KEY=         # 오디오북 TTS (audiobook/tts_elevenlabs.py)

# ── Vercel ─────────────────────────────────────────────────────────────
VERCEL_OIDC_TOKEN=          # 단기 OIDC 토큰 — CI 수동 재현용. 수명이 짧아
                            # 만료되면 재발급(vercel CLI가 배포 시 자동 발급)

# ── Discord 운영 표면 (AD-10·AD-11 — docs/dev/runbooks/DISCORD_ADMIN.md) ─
DISCORD_WEBHOOK_URL=        # 운영 알림 채널 webhook — deploy·keepalive 알림
                            #   발신 지점이 조용히 skip되므로 미설정 허용
DISCORD_APP_ID=             # Developer Portal → Application ID (봇 명령 등록용)
DISCORD_BOT_TOKEN=          # 같은 앱의 Bot 토큰 (npm run admin:discord)
# 참고: DISCORD_PUBLIC_KEY·ADMIN_DISCORD_ID는 .env가 아니라
#       `supabase secrets set`으로 Edge Function 측에 등록한다 (런북 §3.2)
