{
  // 모든 PC의 VS Code 계열 IDE(VS Code·Windsurf·Cursor)가
  // 번들 TS가 아니라 프로젝트에 고정된 typescript(5.9.3)를
  // 진단 엔진으로 사용 — "IDE에 보이는 오류 = check:types 결과" 일치.
  // WebStorm은 Preferences > TypeScript에서 node_modules/typescript 지정.
  "typescript.tsdk": "node_modules\\typescript\\lib",
  // 인코딩 고정 — UTF-8 파일을 CP949 등으로 오판해 재저장하면
  // 이모지가 U+FFFD로 변조된다 (실제 사고 이력 — check:enc 게이트로 유입 차단).
  "files.encoding": "utf8",
  "files.autoGuessEncoding": false
}
