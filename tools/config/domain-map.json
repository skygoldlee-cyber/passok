        "src/theme-init.js",
        "src/theme-toggle.js",
        "src/types.js",
        "src/ui-mode.js",
        "src/ui-utils.js",
        "src/usage-stats.js",
        "src/usage-telemetry.js",
        "src/utils.js",
        "src/views/analysis-view.js",
        "src/views/backup.js",
        "src/views/daily-challenge.js",
        "src/views/dashboard-queue.js",
