#!/bin/sh
# pre-push — push 전 품질 게이트 (opt-in: npm run hooks:install)
#
# 적응형 실행 (tools/check/push_gate.js): origin/main..HEAD diff를 분류해
#   - 로직(src/·tools/·tests/·설정) 포함 → 전체 10단계 (types·trace·specrefs·
#     docs·html·lint·posind·impact·docsync·testfirst)
#   - 문서(docs/·*.md)만 → trace·specrefs·docs·docsync·testfirst
#   - 콘텐츠(content/·data/)만 → trace·specrefs·docsync·testfirst
#     + 신선도 3종(drillfresh·embfresh·docbundles — 파생물 재생성 누락 차단)
#   분류 불가 파일은 보수적으로 로직으로 간주한다.
#
# 건너뛰기: SKIP_PREPUSH=1 git push · 전체 강제: PUSH_GATE_ALL=1 git push

if [ "$SKIP_PREPUSH" = "1" ]; then
    exit 0
fi

echo "▶ pre-push 품질 게이트"
node tools/check/push_gate.js --ref origin/main || exit 1
