# 개행·바이너리 고정
# - 텍스트는 항상 LF로 정규화 (커밋 blob + 체크아웃 작업트리 모두)
#   → Windows autocrlf 환경에서도 바이트 비교·해시 기반 신선도 게이트
#     (check:html·check:trace·check:docbundles)가 플랫폼 비의존으로 동작
* text=auto eol=lf

# 바이너리 — auto 감지에 의존하지 않고 명시
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.pdf binary
*.ttf binary
*.woff binary
*.woff2 binary
# 배포 스탬프 파일 — 전용 머지 드라이버 (tools/merge/merge_stamps.js)
# 양 머신 pull 시 같은 라인에 반복 충돌하는 것을 자동 병합으로 제거
#   (버전 큰 값 채택 / 릴리스 노트 version 키 합집합+20건 트림)
# 드라이버 등록은 clone마다 1회 필요 — `npm.cmd run hooks:install`이 함께 수행
data/version.js merge=stamps
data/release-notes.json merge=stamps
data/release-notes.js merge=stamps
sw.js merge=stamps
package.json merge=stamps
content/**/*.webp filter=lfs diff=lfs merge=lfs -text
content/**/*.png filter=lfs diff=lfs merge=lfs -text
