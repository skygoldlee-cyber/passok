# ============================================
# Git 추적 제외 파일 (.gitignore)
# ============================================
# 대용량 바이너리와 생성 파일은 Git에서 제외
# ============================================

# ---------- 🎧 대용량 오디오 파일 ----------
content/**/audiobook/mp3/
*.mp3

# ---------- 🤖 TTS 모델 파일 ----------
content/**/audiobook/models/
*.onnx
*.pt
*.pth
*.ckpt

# ---------- 🗑️ Python 캐시 ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/

# ---------- 📦 Node ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- 🔧 빌드 아티팩트 ----------
dist/
/build/
*.egg-info/

# ---------- 🧾 SBOM (npm sbom 산출물 — CI 아티팩트·재생성 가능) ----------
sbom.spdx.json

# ---------- 💻 OS/에디터 ----------
.DS_Store
Thumbs.db
*.log
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ---------- 🔐 환경 변수 ----------
.env
.env.local
.env.*.local

# ---------- 📊 생성 진행 상태 ----------
.generation_progress.json
# 복수정답형 감사 리포트·검수 큐 (audit:combo 산출물 — 로컬 전용)
tools/state/combo_audit_report.json
tools/state/study_quality_report.json
tools/state/combo_review_queue.md
# 로컬 운영 대시보드 (report:dashboard 산출물 — 로컬 전용)
tools/state/dashboard_report.html
# 검증 단계 실행 이력 (run.js 텔레메트리 — audit:tools 미실행 감사 입력, 로컬 전용)
tools/state/step_runs.jsonl
# ref_md 변환 진단 리포트 (ref-pipeline 산출물 — 런타임 미사용)
_report.json
# Mermaid 사전렌더 SVG 캐시 (md2doc.py — 재생성 가능)
ref-pipeline/.mermaid_cache/

# ---------- 🧪 테스트 커버리지 ----------
coverage/
coverage-unit/
coverage-merged/

# ---------- 📂 아카이브 ----------
archive/

# ---------- 📄 대용량 HTML (GitHub 100MB 한도 초과) ----------
content/**/*.html
# MD_to_HTML.py 생성 산출물 (로컬 뷰잉용, 재생성 가능)
docs/**/*.html
# MD_to_PDF.py 생성 산출물 (로컬 뷰잉용, 재생성 가능)
docs/**/*.pdf
# 예외: 참조자료 HTML 변환본 (ref_md) — PDF 대체, Git 추적 필요
!content/**/참조자료/ref_md/**/*.html
# 예외: 참조자료 MD 변환본 (ref_md) — 대용량 법령 원문, Git 추적 필요
!content/**/참조자료/ref_md/**/*.md
.vercel
!.vercel/project.json
.env*
!.env.example
# 참조자료 원본 PDF — GitHub Releases 외부 호스팅 (DOC-RBK-12).
# 복원: npm run fetch:refpdfs (pdf_hosting.json 선언 시험만). 매니페스트 pdf_hashes.json·archive_hashes.json·pdf_hosting.json은 추적 유지.
content/**/참조자료/**/*.pdf
# 교재 원본 마스터 PNG — webp 재인코딩용 원본, 런타임은 .webp만 참조.
# GitHub Releases 외부 호스팅 (pdf_hosting.json masterManifests 선언 시험). 복원: npm run fetch:refpdfs
# (ref_md 페이지 이미지 png는 서빙 대상이라 이 패턴에 해당하지 않음 — 경로가 참조자료 아님)
content/exams/*/교재/*/images/*.png
# 스테이징: PDF→MD 재변환 검수 산출물 (로컬 전용)
content/**/참조자료/ref_md_v2/
# 생성 리포트: check_laws.py 등 파이프라인 산출물 (재생성 가능, 로컬 전용)
content/**/report/
# Playwright 실행 산출물
/test-results/
/playwright-report/
/playwright/.cache/

# pytest 임시 디렉터리
ref-pipeline/tests/.pytest-tmp/

# 임베딩 파이프라인 PoC 산출물 (로컬 생성물 — 재생성 가능)
ref-pipeline/embeddings/out/

# AI 제작 초안·평가 산출물 — 리뷰 전 임시 산출물, 정본은 content/ (AI_AUTHORING_DESIGN §2)
tmp/

# 작업용 임시 디렉터리 — 다운로드 원본·변환 중간물 (저작권 제약 자료 포함, 커밋 금지)
.tmp_*/

# 이야기형 정규화 드리프트 검토 리포트 (1회성 산출물)
tools/build/.story_drift_review.md
reports/

# 사용자 학습 데이터 백업 (--stats 입력용, 로컬 전용)
*_backup_*.json

# ---------- 📦 빌드 생성물 (CI·serve·deploy 시 재생성 — 커밋 제외로 .git 팽창·drift 방지) ----------
# build:html·build:data·build:drills·build_doc_bundles가 재생성하는 산출물.
# 추적 유지: embeddings/(수백 MB 모델·수 분 인코딩 — CI·루틴 빌드에서 재생성 비용 회피)·id_migration.js·
# card_terms_snapshot.json(진도 이관·감사 스냅샷)·combo_pilot.js(수작업 파일럿)·
# release-notes.js·version.js(deploy 스탬프 산출물)·manifest.*.webmanifest(소스)
index.html
data/exams.js
data/audio_manifest.js
data/exams/*/registry.js
data/exams/*/question_chapters.js
data/exams/*/notice_diff.json
data/docs_md/
data/exams/*/docs_md/
# drills는 수작업 파일럿(combo_pilot.js)이 섞여 있어 내용물 단위로만 제외
data/exams/*/drills/*
!data/exams/*/drills/combo_pilot.js
data/exams/*/exams/
data/exams/*/exams_md/
data/exams/*/study_md/
data/exams/*/subjects/
data/exams/*/supplements/
