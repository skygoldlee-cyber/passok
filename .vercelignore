# ============================================
# Vercel 배포 제외 파일 (.vercelignore)
# ============================================
# 총 프로젝트 크기: ~1GB+ (오디오 mp3 등 로컬 자산 포함)
# Vercel 배포 대상: 50.5MB / 1,210파일 (2026-10-13 vercel --prod 업로드 페이로드 실측 — 아래 제외 규칙 적용 후)
# ============================================

# ---------- 🎧 대용량 오디오 (302MB) ----------
content/exams/*/audiobook/mp3/
*.mp3

# ---------- 📚 정적 HTML 콘텐츠 ----------
# 교재 본문은 content/*.md 런타임 파싱으로 렌더링 (사전 렌더 HTML 불필요).
# 참조자료 HTML 변환본(ref_md)은 앱 내 HTML 뷰어가 fetch하므로 배포에 포함.
# 루트 index.html(진입점)도 배포에 포함.
# content/html/의 사전 렌더 HTML만 제외 (negation 패턴 대신 디렉토리 단위 제외)
content/exams/*/html/

# ---------- 🗑️ 구(모놀리식) 죽은 데이터 파일 ----------
# index.html은 모듈러 구조(registry + data/subjects·exams/*.hash.js)만 로드한다.
# 아래 구 단일 번들은 어디에서도 로드되지 않으므로(합계 ~1.48MB) 배포에서 제외한다.
# (리포에서도 제거 권장 — 재생성은 tools/build/index.js가 담당)
# data/study_data.js, data/exam_data.js는 이미 삭제됨 — .vercelignore에서도 제거 가능하나
# 혹시 모를 로컬 잔재를 위해 규칙은 유지한다.
data/study_data.js
data/exam_data.js

# ---------- 🗑️ file:// 전용 폴백 번들 (배포 제외) ----------
# data/exams_md/, data/study_md/는 file:// 프로토콜(로컬 직접 열기) 전용 폴백이다.
# http(s) 배포에서는 content/*.md를 직접 fetch하므로 불필요하여 배포에서 제외한다.
# (data/docs_md/는 PWA 오프라인 fetch 실패 시 폴백으로도 사용되므로 배포에 포함 = 제외 규칙 없음)
data/exams/*/exams_md/
data/exams/*/study_md/

# ---------- ⏳ ID 마이그레이션 맵 (배포 포함) ----------
# data/id_migration.js는 교재 교체 시 구ID→신ID 이관 맵으로,
# build:data가 자동 생성하고 index.html이 로드하므로 배포에 포함한다.
# (이전 레거시 일회성 이관용 제외 규칙은 2026-09-21 재도입으로 폐기)

# ---------- 🔁 Vercel 빌드 캐시 ----------
.vercel/
.vercel

# ---------- 📂 아카이브된 원본 폴더 ----------
# content/와 동일한 MD 파일들의 중복 (archive/로 이동됨)
archive/

# ---------- 📊 분석 보고서 (앱 미참조, docs/로 이관) ----------
docs/report_archive/

# ---------- 🖼️ 교재 삽화 PNG 원본 마스터 (배포 제외 — webp만 서빙) ----------
# 교재/*/images/ 아래의 .png는 webp 재인코딩용 원본 마스터 — MD 본문·SW 프리캐시는
# .webp만 참조하므로 배포에서 제외한다 (ref_md 페이지 이미지 png는 서빙 대상이라 제외 안 함).
content/exams/*/교재/*/images/*.png
# (Vercel ignore 매처는 중첩 `**`을 무시하는 경우가 있어 실제 1단계 구조로 명시 —
#  과목별 명시 경로도 병행)
content/exams/cosmetic/교재/law/images/*.png
content/exams/cosmetic/교재/manufacturing/images/*.png
content/exams/cosmetic/교재/safety/images/*.png
content/exams/cosmetic/교재/understanding/images/*.png

# ---------- 📖 참조자료 PDF (배포 제외 — HTML 변환본으로 대체) ----------
# {contentRoot}/참조자료/ 하위 PDF 파일들은 ref_md의 HTML 변환본으로 대체되어 배포에서 제외.
# HTML 변환본(~35MB)만 배포에 포함.
content/exams/*/참조자료/**/*.pdf

# ---------- 🔧 개발 도구 및 파이프라인 ----------
content/exams/*/audiobook/
tools/
*.py
*.ps1
requirements.txt
.generation_progress.json

# ---------- 임시 작업 디렉터리 (배포 제외 — 미커밋 작업·seed 자료) ----------
# .tmp_*/(.tmp/도)는 로컬 임시 분석·seed 원본(PDF 등 저작권 자료 포함) 보관소.
# .gitignore 대상이지만 .vercelignore와는 별개 — 명시 제외 없으면 정적 서빙된다.
.tmp_*/
.tmp/
.pytest_cache/

# ---------- 로컬 산출물 (배포 제외 — 테스트·리포트·AI 초안) ----------
# coverage 리포트가 /.vercelignore 부재로 프로덕션에 공개 서빙되던 것을 차단.
coverage/
coverage-unit/
coverage-merged/
reports/
tmp/

# ---------- 환경 변수 (배포 제외) ----------
# vercel.json 이 public:true 라 배포에 포함된 파일은 정적으로 그대로 서빙된다.
# 비밀(VERCEL_OIDC_TOKEN 등)이 /.env.local 로 공개 노출되지 않도록 명시적으로 제외한다.
.env
.env.local
.env.*.local
.env.example

# ---------- 📦 Node (개발 의존성 — 배포 불필요) ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- 🗑️ 캐시 및 빌드 아티팩트 ----------
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/


# ---------- 💻 OS/에디터 ----------
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/
*.swp
*.swo

# ---------- 📦 Git ----------
.git/
.gitignore
.gitattributes

# ---------- 📝 개발 문서·테스트·CI (배포 불필요) ----------
# docs/user/는 manual-viewer가 런타임 fetch하므로 배포에 포함 (제외하지 않음).
# docs/exams/는 전부 내부 문서(business·design·reference·report_archive·user) —
#   앱 런타임 참조 없음 (user/*.md는 build_doc_bundles 입력일 뿐 번들만 서빙).
#   content/exams/<id>/docs/*.md는 실제 런타임 fetch 대상이라 제외 금지 (섞지 않음).
# ping.txt는 offline-detection 연결 프로브 — 제외 금지.
docs/dev/
docs/business/
docs/exams/
tests/
ref-pipeline/
.github/
.githooks/

# ---------- ⚙️ 개발 전용 설정·도구 (앱 미참조) ----------
serve.js
pytest.ini
playwright.config.js
vitest.config.mjs
eslint.config.mjs
jsconfig.json
package.json
package-lock.json
index.template.html
combo_baseline.json
.nvmrc
.editorconfig

# ---------- 🖼️ 참조자료 원문 삽화 (배포 제외 — 텍스트만 서빙) ----------
# ref_md 원문 보기의 이미지는 배포 대상에서 제외한다 (iteng 23.6만개·97%가 <3KB
# 추출 조각). 프로덕션 원문 보기는 텍스트 기준으로 동작하고 이미지 링크는 404.
content/exams/*/참조자료/ref_md/*/images/

# ---------- 🖼️ 브랜드 로고 원본 마스터 (배포 제외 — icon-*.png만 서빙) ----------
# icons/passok-logo.png(1254px)는 icon-192/512·maskable 생성용 마스터 — 배포 미포함
icons/passok-logo.png

# ---------- 🖼️ ref_md 원본 마스터 (배포 제외 — .webp만 서빙) ----------
# ref_md 이미지는 webp 재인코딩본만 배포 — jpeg/png는 참조 링크 원본 마스터로 저장소 보존
content/exams/*/참조자료/ref_md/*/images/*.jpeg
content/exams/*/참조자료/ref_md/*/images/*.jpg
content/exams/*/참조자료/ref_md/*/images/*.png

# ---------- DA-16 컨텐츠 비평문화 ----------
# 교재 평문 MD는 배포 제외 — 프로덕션은 pk1 인코딩 번들(data/)만 서빙
content/exams/*/교재/*.md
content/exams/*/교재/**/*.md
