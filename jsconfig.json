{
  // 개선안 1-3: 타입 안정성 (점진적 도입)
  // JSDoc(@typedef/@type) 기반의 편집기 자동완성·진단을 활성화합니다.
  // 별도 빌드 단계 없이 VS Code 등 TS 언어 서버가 이 설정을 읽어 검사합니다.
  //
  // [범위]
  //   src/**/*.js 전체를 검사한다 (전 파일 진단 0 에러 — 백로그 소진 완료).
  //   data/ 번들은 생성물이라 제외. tools/의 Node 도구는 jsconfig 대상 아님.
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "strictNullChecks": true,
    // strict 개별 플래그 점진 상향 (2026-10-21 — 전 src 0 에러 확인 후 활성화)
    "alwaysStrict": true,
    "strictBindCallApply": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "useUnknownInCatchVariables": true,
    // noImplicitAny는 잔여 백로그 때문에 보류 — check:any 게이트(tools/check/check_noimplicitany.js
    // + noimplicitany_baseline.json)가 파일별 에러 수 단조 감소를 강제하며 모듈 단위 소진 중 (Phase 1)
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": []
  },
  "include": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "data/audio_manifest.js",
    "tools/supabase/functions/feedback-notify/deno.d.ts",
    "tools/supabase/functions/feedback-notify/index.ts",
    "tools/supabase/functions/admin-bot/deno.d.ts",
    "tools/supabase/functions/admin-bot/index.ts",
    "tools/supabase/functions/ai-proxy/deno.d.ts",
    "tools/supabase/functions/ai-proxy/index.ts"
  ],
  "exclude": [
    "node_modules",
    "vendor",
    "data/exams"
    // checkJs 백로그는 전부 소진됐다 — 신규 파일은 기본으로 검사 대상이 된다.
  ]
}
